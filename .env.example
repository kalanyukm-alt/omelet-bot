# Discord / TrueMoney เดิม
TOKEN=ใส่โทเคนบอท_Discord
PHONE_NUMBER=08xxxxxxxx
LOG_CHANNEL=ใส่ไอดีห้องบันทึกธุรกรรม

# URL สาธารณะของเซิร์ฟเวอร์บอท เช่น https://your-app.example.com
PUBLIC_BASE_URL=https://ใส่โดเมนเซิร์ฟเวอร์ของคุณ

# เริ่มจากคีย์โหมดทดสอบเท่านั้น (sk_test_...)
STRIPE_SECRET_KEY=sk_test_ใส่คีย์ลับโหมดทดสอบ
STRIPE_WEBHOOK_SECRET=whsec_ใส่คีย์ลับของ_webhook_โหมดทดสอบ

# จำกัดยอดที่ผู้ใช้กรอก ป้องกันการพิมพ์ยอดผิด
STRIPE_MAX_AMOUNT_BAHT=5000

# ห้ามเปิดบรรทัดนี้จนกว่าจะทดสอบ webhook และการแจกยศผ่านแล้ว
# STRIPE_ALLOW_LIVE=true
